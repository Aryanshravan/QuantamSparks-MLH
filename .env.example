# Hugging Face Token (Required for Gemma inference)
# Create at: https://huggingface.co/settings/tokens (Read permissions)
HF_TOKEN=

# Gemma Model Identifier
GEMMA_MODEL=google/gemma-3-4b-it
HF_MODEL=google/gemma-3-4b-it

# GitHub Token (Optional, for higher rate limits on public repos)
# Create at: https://github.com/settings/tokens (Public read permissions only)
GITHUB_TOKEN=

# Server Port
PORT=5000
